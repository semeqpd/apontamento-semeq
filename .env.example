# Portal SEMEQ - Variáveis de Ambiente
# Copie para .env e ajuste os valores antes de subir com Docker ou executar localmente.
# copy .env.example .env   (Windows)
# cp .env.example .env     (Linux/macOS)

# ===== NÚCLEO =====
# Obrigatório. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Banco de dados: 'sqlite' (padrão) ou 'postgres'
DJANGO_DB_ENGINE=postgres

# ===== BANCO DE DADOS =====
DJANGO_DB_NAME=apontamento
DJANGO_DB_USER=apontamento
DJANGO_DB_PASSWORD=apontamento
DJANGO_DB_HOST=db           # 'db' no Docker / 'localhost' localmente
DJANGO_DB_PORT=5432

# ===== EXECUÇÃO =====
# False em produção (o Docker já força False)
DJANGO_DEBUG=False
# Hosts permitidos separados por vírgula. Use * apenas para teste local.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== HTTPS (produção) =====
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False