# Portal SEMEQ - Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores
# NUNCA commite o arquivo .env (contém segredos)

# ============================================
# DJANGO CORE
# ============================================
# Gere uma nova chave: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=sua_chave_secreta_aqui_gerada_com_get_random_secret_key

# Debug: True para desenvolvimento, False para produção
DJANGO_DEBUG=True

# Hosts permitidos (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Domínios de email permitidos para cadastro (separados por vírgula)
# ALLOWED_EMAIL_DOMAINS=semeq.com,empresa.com
ALLOWED_EMAIL_DOMAINS=semeq.com

# ============================================
# BANCO DE DADOS
# ============================================
# Opção 1: SQLite (padrão - zero config, arquivo local db.sqlite3)
# Deixe DJANGO_DB_ENGINE vazio ou comente as linhas abaixo

# Opção 2: PostgreSQL (produção/recomendado)
# Descomente e configure:
DJANGO_DB_ENGINE=postgres
DJANGO_DB_NAME=apontamento
DJANGO_DB_USER=admin
DJANGO_DB_PASSWORD=Semeq@2026abc
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# --------------------------------------------
# Como criar o banco PostgreSQL (execute no psql):
# --------------------------------------------
# CREATE ROLE admin WITH LOGIN PASSWORD 'Semeq@2026abc' SUPERUSER CREATEDB;
# CREATE DATABASE apontamento OWNER admin;
# GRANT ALL PRIVILEGES ON DATABASE apontamento TO admin;
#
# IMPORTANTE: O usuário/senha do .env DEVEM ser IGUAIS aos criados no PostgreSQL.
# O Django NÃO cria o role/database automaticamente - faça isso ANTES de rodar migrate.

# ============================================
# OUTRAS CONFIGURAÇÕES (opcionais)
# ============================================
# Timezone
# TIME_ZONE=America/Sao_Paulo

# Language
# LANGUAGE_CODE=pt-BR

# Static files (para produção com collectstatic)
# STATIC_ROOT=/var/www/seu-projeto/static

# Email (configure para produção)
# Development: usa console backend (imprime no terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu@email.com
# EMAIL_HOST_PASSWORD=sua_senha_email
# DEFAULT_FROM_EMAIL=SEMEQ <noreply@semeq.com>

# ============================================
# CREDENCIAIS PADRÃO (após rodar setup_usuarios)
# ============================================
# TODOS os usuários criados pelo setup_usuarios usam senha: Semeq@123
#
# admin         -> Superuser (acesso total, Django admin)
# gestor        -> Gestor global (dashboard, clientes, usuários, relatórios)
# gestor2       -> Gestor global extra
# lider_pmc     -> Líder time PMC (apontamentos do time PMC)
# lider_pmc2    -> Líder time PMC extra
# lider_shd     -> Líder time SHD (apontamentos do time SHD)
# lider_shd2    -> Líder time SHD extra
# colab_pmc1-10 -> Colaboradores PMC (apenas próprios apontamentos)
# colab_shd1-10 -> Colaboradores SHD (apenas próprios apontamentos)
#
# Total: 27 usuários